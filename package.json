{
  "name": "dsh-smooth-skin",
  "version": "0.1.0",
  "description": "Smooth：DSH Web 界面皮肤 —— 统一配色、圆角与列表卡片，内置初雪白/玄铁黑等六种主题预设",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "README.md", "icon.svg"],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "icons": "node tools/export-icons.mjs",
    "check:host": "node tools/host-contract.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-account",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ]
    }
  }
}
